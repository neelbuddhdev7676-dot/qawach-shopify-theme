{% schema %}
{
  "name": "Tabbed Collections",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "New In!"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Tabbed Collections",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% comment %} Styles for tabbed collections {% endcomment %}
<style>
  .tabbed-container {
    /* max-width: 1200px; */
    margin: 0 auto;
  }

  .tabbed-container h2 {
    font-weight: 600 !important;
    font-size: calc(var(--font-heading-scale) * 4rem);
  }

  .tabs-nav-container {
    position: relative;
    overflow: hidden;
  }

  .tabs-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin: 2rem 0;
    flex-wrap: wrap;
  }

  .tabs-nav h4 {
    color: #121212;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    transition: color 0.3s ease;
    white-space: nowrap;
    margin: 0.4rem 0.75rem;
    cursor: pointer;
  }

  .tabs-nav h4:hover {
    color: #A52A2A;
  }

  .tabs-nav .active-tab {
    color: #A52A2A;
    font-weight: 600;
  }

  /* Grid layout for the product collections */
  .collection-products {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    padding: 0;
  }

  .collection-products.active {
    display: grid;
    opacity: 1;
    gap: 2rem;
    /* Default to 3 columns on desktop */
    grid-template-columns: repeat(3, 1fr);
  }

  .card__media {
    /* aspect-ratio: 1/1; */
  }

  /* Tablet: 2 products per row */
  @media (max-width: 1024px) {
    .collection-products.active {
      grid-template-columns: repeat(2, 1fr);
      padding: 0;
    }
  }

  /* Mobile: 1 product per row */
  @media (max-width: 767px) {
    .tabbed-container {
      padding: 40px 0px;
    }
    .tabbed-container h2 {
      font-size: calc(var(--font-heading-scale) * 2.8rem);
      padding: 0 10px;
    }
    .tabs-nav {
      display: flex;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: center;
      margin: 0;
      padding: 0 0.5rem;
      gap: 1rem;
      overflow-x: auto;
      height: fit-content;
      scrollbar-width: none; /* Firefox */
      border-top:1px solid #eaeaea;
      border-bottom: 1px solid #eaeaea;
    }
    .tabs-nav::-webkit-scrollbar {
      display: none; /* Chrome, Safari */
    }
    .tabs-nav h4 {
      margin: 0rem 0rem;
      padding: 1rem 1rem;
      font-size: 13px;
    }
    .tabs-nav .active-tab {
      background-color: #eaeaea;
    }
    .tabs-nav-container::after {
        content: "";
        position: absolute;
        top: 0px;
        bottom: 0px;
        width: 15px;
        pointer-events: none;
        display: block;
        height: 50px;
        z-index: 1000;
        left: 0px;
        background: linear-gradient(to left, rgba(255, 255, 255, 0), rgba(0, 0, 0, 0.2));
    }
    .tabs-nav-container::before {
        content: "";
        position: absolute;
        top: 0px;
        bottom: 0px;
        width: 15px;
        pointer-events: none;
        display: block;
        height: 50px;
        z-index: 1000;
        right: 0px;
        background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(0, 0, 0, 0.2));
    }
    .tabs-nav-container {
      margin-bottom: 50px;
    }
    .collection-products.active {
      grid-template-columns: repeat(1, 1fr);
      padding: 0 10px;
    }
    .view-more-wrapper {
      padding: 0 10px;
    }
  }

  .collection-products-notfound {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
  }

  .view-more-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .view-more-button {
    color: #A52A2A;
    text-decoration: none;
    font-weight: 600;
    position: relative;
  }

  .view-more-button::after {
    content: '';
    width: 0;
    height: 2px;
    position: absolute;
    left: 0;
    bottom: -3px;
    background: #A52A2A;
    transition: width 0.3s ease;
  }

  .view-more-button:hover::after {
    width: 100%;
  }
</style>

{% assign tab_collection_map = 'New In!:men-s-leather-jackets,Leather Jackets:leather-jacket-for-men,Leather Pants:leather-pants,Leather Skirts:leather-skirts,Offerings:pillow-cover'
  | split: ','
%}

<div class="tabbed-container page-width">
  <h2>Featured Collections</h2>
  <div class="tabs-nav-container">
    <div class="tabs-nav">
      {% for tab in tab_collection_map %}
        {% assign pair = tab | split: ':' %}
        {% assign label = pair[0] %}
        {% assign handle = pair[1] %}
        <h4 onclick="showCollection('{{ handle }}', this)">{{ label }}</h4>
      {% endfor %}
    </div>
  </div>

  {% for tab in tab_collection_map %}
    {% assign pair = tab | split: ':' %}
    {% assign label = pair[0] %}
    {% assign handle = pair[1] %}
    {% assign collection = collections[handle] %}
    <ul class="collection-products {% if forloop.first %}active{% endif %}" id="{{ handle }}">
      {% if collection.products.size == 0 %}
        <p class="collection-products-notfound">No products found in {{ label }} collection.</p>
      {% else %}
        {% for product in collection.products limit: 6 %}
          {% render 'card-product',
            card_product: product,
            media_aspect_ratio: 'portrait',
            show_secondary_image: true,
            show_vendor: false,
            section_id: handle
          %}
        {% endfor %}
      {% endif %}
    </ul>
  {% endfor %}

  <div class="view-more-wrapper">
    <a id="view-more-link" class="view-more-button-removed button button-secondary" href="#">View More</a>
  </div>
</div>

<script>
  function showCollection(id, el) {
    document.querySelectorAll('.collection-products').forEach(section => {
      section.classList.remove('active');
    });

    const activeSection = document.getElementById(id);
    if (activeSection) {
      activeSection.classList.add('active');
    }

    document.querySelectorAll('.tabs-nav h4').forEach(tab => {
      tab.classList.remove('active-tab');
    });
    el.classList.add('active-tab');

    document.getElementById("view-more-link").href = `/collections/${id}`;
  }

  document.addEventListener("DOMContentLoaded", function () {
    setTimeout(() => {
      const defaultTab = document.querySelector('.tabs-nav h4');
      if (defaultTab) {
        defaultTab.click();
      }
    }, 100);
  });

  const wrapper = document.querySelector('.tabs-nav-container');
  const nav = wrapper.querySelector('.tabs-nav');

  function updateFadeIndicators() {
    const scrollLeft = nav.scrollLeft;
    const scrollWidth = nav.scrollWidth;
    const clientWidth = nav.clientWidth;
    wrapper.classList.toggle('fade-left', scrollLeft > 0);
    wrapper.classList.toggle('fade-right', scrollLeft + clientWidth < scrollWidth);
  }

  nav.addEventListener('scroll', updateFadeIndicators);
  window.addEventListener('resize', updateFadeIndicators);
  window.addEventListener('load', updateFadeIndicators);
</script>
