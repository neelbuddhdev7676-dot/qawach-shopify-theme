          {%# assign keywords = section.settings.seo_keywords | split: ',' %}
          {%# for keyword in keywords %}
            <!-- <span>{{ keyword | strip }}</span> -->
          {%# endfor %}
        <!-- </div> -->
      {%# endif %}
    <!-- </div> -->
    {%# endif %}
  </div>
</div>

