{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .edit-customization {
    cursor: pointer;
    width: max-content;
    display: inline-flex;
    align-items: center;
    gap: 8px; /* Space between icon and text */
    color: #000; /* Default text color */
    transition: color 0.2s ease;
    font-size: 14px;
    /* font-weight: 600; */
  }

  .edit-customization .edit-icon {
    color: currentColor; /* Inherits parent's color */
    transition: color 0.2s ease;
  }

  .edit-customization:hover {
    color: #a52a2a;
  }

  .custom-price {
    font-size: 13px !important;
  }
  .cart-item__old-price span {
    text-decoration: line-through;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'customization-modal.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-section-id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                  {% unless item.product.tags contains 'customization_addon' %}
                    <tr class="cart-item" id="CartItem-{{ item.index | plus: 1 }}" data-cart-item data-product-tags="{{ item.product.tags | join: ',' }}">
                      <td class="cart-item__media">
                        {% if item.image %}
                          {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                          <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                          <div class="cart-item__image-container gradient global-media-settings">
                            <img
                              src="{{ item.image | image_url: width: 300 }}"
                              class="cart-item__image"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          </div>
                        {% endif %}
                      </td>

                      <td class="cart-item__details">
                        {%- if settings.show_vendor -%}
                          <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                        {%- endif -%}

                        <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                        {%- if item.original_price != item.final_price -%}
                          <div class="cart-item__discounted-prices">
                            <span class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </span>
                            <s class="cart-item__old-price product-option">
                              {{- item.original_price | money -}}
                            </s>
                            <span class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </span>
                            <strong class="cart-item__final-price product-option">
                              {{ item.final_price | money }}
                            </strong>
                          </div>
                        {%- else -%}
                          <div class="product-option">
                            {{ item.original_price | money }}
                          </div>
                        {%- endif -%}
{%- unless item.product.tags contains 'pillow cover' or item.product.tags contains 'leather skin hide' -%}
                        {%- if item.product.has_only_default_variant == false
                          or item.properties.size != 0
                          or item.selling_plan_allocation != null
                        -%}
                          
                            <dl>
                              {%- assign bundle_id = item.properties.bundle_id -%}
                              <div
                                class="edit-customization"
                                data-item-key="{{ item.key }}"
                                {#
                                Common
                                fields
                                #}
                                data-hardware="{{ item.properties['Hardware Color'] | default: 'Antique Silver' }}"
                                data-lining="{{ item.properties['Lining'] | default: 'Default' }}"
                                data-quilt="{{ item.properties['Quilted Lining'] | default: 'No' }}"
                                data-mono1="{{ item.properties['Monogram Line 1'] | split: '(' | first | strip }}"
                                data-mono2="{{ item.properties['Monogram Line 2'] | split: '(' | first | strip }}"
                                data-comments="{{ item.properties['Comments'] }}"

                                {#
                                Upperwear
                                measurements
                                #}
                                data-weight="{{ item.properties['Weight'] | split: 'cm' | first | strip }}"
                                data-height="{{ item.properties['Height'] | split: 'cm' | first | strip }}"
                                data-shoulder="{{ item.properties['Shoulder'] | split: 'cm' | first | strip }}"
                                data-sleeves="{{ item.properties['Sleeves'] | split: 'cm' | first | strip }}"
                                data-chest="{{ item.properties['Chest'] | split: 'cm' | first | strip }}"
                                data-waist="{{ item.properties['Waist'] | split: 'cm' | first | strip }}"
                                data-hip="{{ item.properties['Hip'] | split: 'cm' | first | strip }}"
                                data-bicep="{{ item.properties['Bicep'] | split: 'cm' | first | strip }}"
                                data-cuff="{{ item.properties['Cuff'] | split: 'cm' | first | strip }}"

                                {#
                                Pant
                                measurements
                                #}
                                data-waist_circumference="{{ item.properties['Waist_circumference'] | split: 'cm' | first | strip }}"
                                data-hip_width="{{ item.properties['Hip_width'] | split: 'cm' | first | strip }}"
                                data-thigh_width="{{ item.properties['Thigh_width'] | split: 'cm' | first | strip }}"
                                data-knee_width="{{ item.properties['Knee_width'] | split: 'cm' | first | strip }}"
                                data-leg_bottom="{{ item.properties['Leg_bottom'] | split: 'cm' | first | strip }}"
                                data-front_rise="{{ item.properties['Front_rise'] | split: 'cm' | first | strip }}"
                                data-back_rise="{{ item.properties['Back_rise'] | split: 'cm' | first | strip }}"
                                data-length_waist_ankle="{{ item.properties['Length_waist_ankle'] | split: 'cm' | first | strip }}"

                                {#
                                Skirt
                                measurements
                                #}
                                data-bottom="{{ item.properties['Bottom'] | split: 'cm' | first | strip }}"
                                data-length="{{ item.properties['Length'] | split: 'cm' | first | strip }}"

                                data-variant-id="{{ item.variant_id }}"
                                data-tags="{{ item.product.tags | json | escape }}"
                                data-quantity="{{ item.quantity }}"
                                data-title="{{ item.product.title }}"
                                data-bundle-id="{{ bundle_id }}"
                                data-base-price="{{ item.final_line_price | divided_by: 100.0 }}"
                              >
                                <svg
                                  class="edit-icon"
                                  fill="currentColor"
                                  version="1.1"
                                  id="Capa_1"
                                  xmlns="http://www.w3.org/2000/svg"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  width="16px"
                                  height="16px"
                                  viewBox="0 0 494.936 494.936"
                                  xml:space="preserve"
                                >
                                  <g>
                                    <g>
                                      <path d="M389.844,182.85c-6.743,0-12.21,5.467-12.21,12.21v222.968c0,23.562-19.174,42.735-42.736,42.735H67.157
                                        c-23.562,0-42.736-19.174-42.736-42.735V150.285c0-23.562,19.174-42.735,42.736-42.735h267.741c6.743,0,12.21-5.467,12.21-12.21
                                        s-5.467-12.21-12.21-12.21H67.157C30.126,83.13,0,113.255,0,150.285v267.743c0,37.029,30.126,67.155,67.157,67.155h267.741
                                        c37.03,0,67.156-30.126,67.156-67.155V195.061C402.054,188.318,396.587,182.85,389.844,182.85z"/>
                                      <path d="M483.876,20.791c-14.72-14.72-38.669-14.714-53.377,0L221.352,229.944c-0.28,0.28-3.434,3.559-4.251,5.396l-28.963,65.069
                                        c-2.057,4.619-1.056,10.027,2.521,13.6c2.337,2.336,5.461,3.576,8.639,3.576c1.675,0,3.362-0.346,4.96-1.057l65.07-28.963
                                        c1.83-0.815,5.114-3.97,5.396-4.25L483.876,74.169c7.131-7.131,11.06-16.61,11.06-26.692
                                        C494.936,37.396,491.007,27.915,483.876,20.791z M466.61,56.897L257.457,266.05c-0.035,0.036-0.055,0.078-0.089,0.107
                                        l-33.989,15.131L238.51,247.3c0.03-0.036,0.071-0.055,0.107-0.09L447.765,38.058c5.038-5.039,13.819-5.033,18.846,0.005
                                        c2.518,2.51,3.905,5.855,3.905,9.414C470.516,51.036,469.127,54.38,466.61,56.897z"/>
                                    </g>
                                  </g>
                                </svg>
                                Edit Customizations
                              </div>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <dt>{{ option.name }}:</dt>
                                    <dd>{{ option.value }}</dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- assign measurement_properties = 'Weight,Height,Shoulder,Sleeves,Chest,Waist,Hip,Bicep,Cuff,Waist_circumference,Hip_width,Thigh_width,Knee_width,Leg_bottom,Front_rise,Back_rise,Length_waist_ankle,Bottom,Length' | split: ',' -%}
                              {%- assign measurement_system = item.properties['Measurement System'] | default: 'Metric (kg/cm)' -%}

                              {%- for property in item.properties -%}
                                {%- unless property.last == blank or property.first == 'bundle_id' or property.first == 'Measurement System' -%}
                                  {%- assign is_measurement = false -%}
                                  {%- for m in measurement_properties -%}
                                    {%- if m == property.first -%}
                                      {%- assign is_measurement = true -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if is_measurement -%}
                                        {%- assign value = property.last | split: ' ' | first -%}
                                        {%- if property.first == 'Weight' -%}
                                          {{ value | remove: 'kg' }}kg (Custom)
                                        {%- else -%}
                                          {{ value | remove: 'cm' }}cm (Custom)
                                        {%- endif -%}
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endunless -%}
                              {%- endfor -%}
                              {%- if measurement_system != blank -%}
                                <div class="product-option measurement-system-note">
                                  <em>Measurements entered in: {{ measurement_system }}</em>
                                </div>
                              {%- endif -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}
                        {%- endunless -%}

                        <ul
                          class="discounts list-unstyled"
                          role="list"
                          aria-label="{{ 'customer.order.discount' | t }}"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {{- 'icon-discount.svg' | inline_asset_content -}}
                              {{ discount.discount_application.title | escape }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </td>

                      <td class="cart-item__totals right medium-hide large-up-hide">
                        {%- render 'loading-spinner' -%}
                        <div class="cart-item__price-wrapper">
                          {%- if item.original_line_price != item.final_line_price -%}
                            <dl class="cart-item__discounted-prices">
                              <dt class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </dt>
                              <dd>
                                <s class="cart-item__old-price price price--end">
                                  {{ item.original_line_price | money }}
                                </s>
                              </dd>
                              <dt class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </dt>
                              <dd class="price price--end">
                                {{ item.final_line_price | money }}
                              </dd>
                            </dl>
                          {%- else -%}
                            <span class="price price--end">
                              {{ item.original_line_price | money }}
                            </span>
                          {%- endif -%}

                          {%- if item.variant.available and item.unit_price_measurement -%}
                            <div class="unit-price caption">
                              <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                              {{ item.unit_price | money }}
                              <span aria-hidden="true">/</span>
                              <span class="visually-hidden"
                                >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                              >
                              {%- if item.unit_price_measurement.reference_value != 1 -%}
                                {{- item.unit_price_measurement.reference_value -}}
                              {%- endif -%}
                              {{ item.unit_price_measurement.reference_unit }}
                            </div>
                          {%- endif -%}
                          {% assign base_price = item.final_line_price %}
                          {% assign addon_total = 0.0 %}
                          {% assign measurement_properties = 'Weight,Height,Shoulder,Sleeves,Chest,Waist,Hip,Bicep,Cuff'
                            | split: ','
                          %}

                          {% for property in item.properties %}
                            {% unless property.last == blank
                              or property.first == 'bundle_id'
                              or measurement_properties contains property.first
                            %}
                              {% assign price_part = property.last
                                | split: '(+$'
                                | last
                                | split: ')'
                                | first
                                | plus: 0.0
                              %}
                              {% assign price_part = price_part | times: 100 %}
                              {% assign price_part_with_quantity = price_part | times: item.quantity %}
                              {% assign addon_total = addon_total | plus: price_part_with_quantity %}

                              {% if price_part_with_quantity != 0 %}
                                <dd class="price price--end custom-price">+{{ price_part_with_quantity | money }}</dd>
                              {% endif %}
                            {% endunless %}
                          {% endfor %}
                          {% if addon_total > 0.0 %}
                            {% assign grand_total = base_price | plus: addon_total %}
                            <p>
                              <strong>Total: {{ grand_total | money }}</strong>
                            </p>
                          {% endif %}
                        </div>
                      </td>
                      {%- liquid
                        assign has_qty_rules = false
                        if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                          assign has_qty_rules = true
                        endif

                        assign has_vol_pricing = false
                        if item.variant.quantity_price_breaks.size > 0
                          assign has_vol_pricing = true
                        endif
                      -%}
                      <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                        <quantity-popover>
                          <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                            <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                              {{ 'products.product.quantity.label' | t }}
                            </label>
                            <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                              {%- if has_qty_rules or has_vol_pricing -%}
                                <button
                                  type="button"
                                  aria-expanded="false"
                                  class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                                >
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </button>
                              {%- endif -%}
                              <quantity-input class="quantity cart-quantity">
                                <button class="quantity__button" name="minus" type="button">
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.decrease'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  <span class="svg-wrapper">
                                    {{- 'icon-minus.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                <input
                                  class="quantity__input"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  type="number"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  {% # theme-check-disable %}
                                  data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                  min="0"
                                  data-min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  {% # theme-check-enable %}
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                  id="Quantity-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                <button class="quantity__button" name="plus" type="button">
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.increase'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  <span class="svg-wrapper">
                                    {{- 'icon-plus.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </quantity-input>
                            </div>
                            <cart-remove-button
                              id="Remove-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                              <a
                                href="{{ item.url_to_remove }}"
                                class="button button--tertiary"
                                aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-remove.svg' | inline_asset_content -}}
                                </span>
                              </a>
                            </cart-remove-button>
                          </div>
                          {%- if has_qty_rules or has_vol_pricing -%}
                            <button
                              type="button"
                              class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                              aria-expanded="false"
                            >
                              {{- 'icon-info.svg' | inline_asset_content -}}
                              <span>
                                {%- if has_vol_pricing -%}
                                  {{ 'products.product.volume_pricing.note' | t }}
                                {%- elsif has_qty_rules -%}
                                  {{ 'products.product.quantity.note' | t }}
                                {%- endif -%}
                              </span>
                            </button>
                          {%- endif -%}
                          {%- if has_vol_pricing or has_qty_rules -%}
                            <div
                              class="cart-items__info global-settings-popup quantity-popover__info"
                              tabindex="-1"
                              hidden
                            >
                              {%- if has_qty_rules == false -%}
                                <span class="volume-pricing-label caption">
                                  {{- 'products.product.volume_pricing.title' | t -}}
                                </span>
                              {%- endif -%}
                              <div class="quantity__rules caption">
                                {%- if item.variant.quantity_rule.increment > 1 -%}
                                  <span class="divider">
                                    {{-
                                      'products.product.quantity.multiples_of'
                                      | t: quantity: item.variant.quantity_rule.increment
                                    -}}
                                  </span>
                                {%- endif -%}
                                {%- if item.variant.quantity_rule.min > 1 -%}
                                  <span class="divider">
                                    {{-
                                      'products.product.quantity.min_of'
                                      | t: quantity: item.variant.quantity_rule.min
                                    -}}
                                  </span>
                                {%- endif -%}
                                {%- if item.variant.quantity_rule.max != null -%}
                                  <span class="divider">
                                    {{-
                                      'products.product.quantity.max_of'
                                      | t: quantity: item.variant.quantity_rule.max
                                    -}}
                                  </span>
                                {%- endif -%}
                              </div>
                              <button
                                class="button-close button button--tertiary large-up-hide"
                                type="button"
                                aria-label="{{ 'accessibility.close' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-close.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                <volume-pricing class="parent-display">
                                  <ul class="list-unstyled">
                                    <li>
                                      <span>{{ item.variant.quantity_rule.min }}+</span>
                                      {%- assign price = item.variant.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                    {%- for price_break in item.variant.quantity_price_breaks -%}
                                      <li>
                                        <span>
                                          {{- price_break.minimum_quantity -}}
                                          <span aria-hidden="true">+</span></span
                                        >
                                        {%- assign price = price_break.price | money_with_currency -%}
                                        <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </volume-pricing>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                          <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                            <small class="cart-item__error-text"></small>
                            <span class="svg-wrapper">
                              {{- 'icon-error.svg' | inline_asset_content -}}
                            </span>
                          </div>
                        </quantity-popover>
                      </td>

                      <td class="cart-item__totals right small-hide">
                        {%- render 'loading-spinner' -%}
                        <div class="cart-item__price-wrapper">
                          {%- if item.original_line_price != item.final_line_price -%}
                            <dl class="cart-item__discounted-prices">
                              <dt class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </dt>
                              <dd>
                                <s class="cart-item__old-price price price--end">
                                  {{ item.original_line_price | money }}
                                </s>
                              </dd>
                              <dt class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </dt>
                              <dd class="price price--end">
                                {{ item.final_line_price | money }}
                              </dd>
                              {% assign base_price = item.final_line_price %}
                              {% assign addon_total = 0.0 %}
                              {% assign measurement_properties = 'Weight,Height,Shoulder,Sleeves,Chest,Waist,Hip,Bicep,Cuff'
                                | split: ','
                              %}
                              {% for property in item.properties %}
                                {% if property.last contains '$' %}
                                  {% unless property.last == blank
                                    or property.first == 'bundle_id'
                                    or measurement_properties contains property.first
                                  %}
                                    {% assign price_part = property.last
                                      | split: '(+$'
                                      | last
                                      | split: ')'
                                      | first
                                      | plus: 0.0
                                    %}
                                    {% assign price_part = price_part | times: 100 %}
                                    {% assign price_part_with_quantity = price_part | times: item.quantity %}
                                    {% assign addon_total = addon_total | plus: price_part_with_quantity %}

                                    {% if price_part_with_quantity != 0 %}
                                      <dd class="price price--end">+{{ price_part_with_quantity | money }}</dd>
                                    {% endif %}
                                  {% endunless %}
                                {% endif %}
                              {% endfor %}
                              {% # if addon_total > 0 %}
                              {% assign grand_total = base_price | plus: addon_total %}
                              <p>
                                <strong>Total: {{ grand_total | money }}</strong>
                              </p>
                              {% # endif %}
                            </dl>
                          {%- else -%}
                            <span class="price price--end" style="display: flex;flex-direction: column;">
                              {{ item.original_line_price | money }}
                              {% assign base_price = item.final_line_price %}
                              {% assign addon_total = 0.0 %}

                              {% for property in item.properties %}
                                {% unless property.last == blank
                                  or property.first == 'bundle_id'
                                  or measurement_properties contains property.first
                                %}
                                  {% assign price_part = property.last
                                    | split: '(+$'
                                    | last
                                    | split: ')'
                                    | first
                                    | plus: 0.0
                                  %}
                                  {% assign price_part = price_part | times: 100 %}
                                  {% assign price_part_with_quantity = price_part | times: item.quantity %}
                                  {% assign addon_total = addon_total | plus: price_part_with_quantity %}

                                  {% if price_part_with_quantity != 0 %}
                                    <dd class="price price--end">+{{ price_part_with_quantity | money }}</dd>
                                  {% endif %}
                                {% endunless %}
                              {% endfor %}
                              {% # if addon_total > 0 %}
                              {% assign grand_total = base_price | plus: addon_total %}
                              <p>
                                <strong>Total: {{ grand_total | money }}</strong>
                              </p>
                            </span>
                          {%- endif -%}

                          {%- if item.variant.available and item.unit_price_measurement -%}
                            <div class="unit-price caption">
                              <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                              {{ item.unit_price | money }}
                              <span aria-hidden="true">/</span>
                              <span class="visually-hidden"
                                >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                              >
                              {%- if item.unit_price_measurement.reference_value != 1 -%}
                                {{- item.unit_price_measurement.reference_value -}}
                              {%- endif -%}
                              {{ item.unit_price_measurement.reference_unit }}
                            </div>
                          {%- endif -%}
                        </div>
                      </td>
                    </tr>
                  {%- endunless -%}
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>
{% render 'customization-modal', customization_collection: collections['customization-addons'], product: product %}

<script>
  document.querySelectorAll('form[action="/cart"]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      const checkoutButton = form.querySelector('button[name="checkout"]');
      if (checkoutButton && e.submitter === checkoutButton) {
        e.preventDefault(); // Stop immediate submit

        // Refresh cart server-side
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates: {} }), // empty payload just syncs quantities
        });

        // Now safely redirect to checkout
        form.submit();
      }
    });
  });
</script>

{%- assign main_bundle_ids = '' | split: ',' -%}
{%- assign orphan_addon_keys = '' | split: ',' -%}
{%- assign has_main_product = false -%}
{%- assign has_addon = false -%}

{%- for item in cart.items -%}
  {%- if item.product.tags contains 'customization_addon' -%}
    {%- assign has_addon = true -%}
  {%- else -%}
    {%- assign has_main_product = true -%}
    {%- if item.properties.bundle_id != blank -%}
      {%- assign main_bundle_ids = main_bundle_ids | push: item.properties.bundle_id -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- for item in cart.items -%}
  {%- if item.product.tags contains 'customization_addon' -%}
    {%- assign addon_bundle_id = item.properties.bundle_id -%}
    {%- assign is_orphan = false -%}
    {%- if has_main_product == false -%}
      {%- assign is_orphan = true -%}
    {%- elsif addon_bundle_id != blank -%}
      {%- unless main_bundle_ids contains addon_bundle_id -%}
        {%- assign is_orphan = true -%}
      {%- endunless -%}
    {%- endif -%}
    {%- if is_orphan -%}
      {%- assign orphan_addon_keys = orphan_addon_keys | push: item.key -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<script>
  window.orphanAddonKeys = {{ orphan_addon_keys | json }};
</script>

{%- if has_addon and has_main_product == false -%}
  <div class="cart-addon-warning">
    ⚠️ Customization add-ons cannot be purchased alone. Please add a main product to your cart.
  </div>
  <style>
    .cart__checkout-button, .cart__ctas button[type="submit"] {
      opacity: 0.5 !important;
      cursor: not-allowed !important;
      pointer-events: none !important;
    }
  </style>
{%- endif -%}

