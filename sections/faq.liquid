{% schema %}
{
  "name": "FAQ Simple",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",  // Only one block type
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category Name",
          "default": "General"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Simple",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "category": "Shipping",
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship within 1-2 business days.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Returns",
            "question": "What's your return policy?",
            "answer": "<p>30-day return policy.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .faq-section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    font-family: sans-serif;
  }

  .faq-section h2 {
    text-align: center;
    margin-bottom: 3rem;
    font-size: 2.4rem;
    font-weight: 700;
  }

  .faq-category {
    margin-bottom: 3rem;
  }

  .faq-category h3 {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
    padding-bottom: 1rem;
    color: var(--color-foreground);
  }

  .faq-item {
    margin-bottom: 1.5rem;
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 0.8rem;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    transition: box-shadow 0.3s ease;
  }

  .faq-question {
    width: 100%;
    padding: 1.5rem;
    background: transparent;
    border: none;
    font-size: 1.6rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.3s ease;
  }

  .faq-question:hover {
    background: rgba(var(--color-foreground), 0.03);
  }

  .faq-icon {
    transition: transform 0.3s ease;
    font-size: 2rem;
    display: inline-block;
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg); /* Turns + into × */
  }

  .faq-answer {
    padding: 0 1.5rem;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      max-height 0.4s ease,
      padding 0.4s ease,
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  /* When expanded */
  .faq-question[aria-expanded="true"] + .faq-answer {
    max-height: 500px; /* rough estimate of max content height */
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    opacity: 1;
    transform: translateY(0);
  }


  /* 🌐 Mobile responsiveness */
  @media (max-width: 768px) {
    .faq-section {
      padding: 3rem 1.5rem;
    }

    .faq-section h2 {
      font-size: 2rem;
    }

    .faq-category h3 {
      font-size: 1.6rem;
    }

    .faq-question {
      font-size: 1.4rem;
      padding: 1.2rem;
    }

    .faq-answer {
      font-size: 1.3rem;
      padding-left: 1.2rem;
      padding-right: 1.2rem;
    }

    .faq-question[aria-expanded="true"] + .faq-answer {
      padding-bottom: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .faq-section {
      padding: 2rem 1rem;
    }

    .faq-section h2 {
      font-size: 1.8rem;
    }

    .faq-category h3 {
      font-size: 1.4rem;
    }

    .faq-question {
      font-size: 1.3rem;
      padding: 1rem;
    }

    .faq-icon {
      font-size: 1.6rem;
    }

    .faq-answer {
      font-size: 1.2rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .faq-question[aria-expanded="true"] + .faq-answer {
      padding-bottom: 1rem;
    }
  }
  .faq-search {
    display: block;
    width: 100%;
    max-width: 500px;
    margin: 0 auto 3rem auto;
    padding: 1.2rem 1.5rem;
    font-size: 1.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 0.8rem;
    outline: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: border-color 0.3s ease;
  }

  .faq-search:focus {
    border-color: rgba(var(--color-foreground), 0.4);
  }
</style>

<div class="faq-section page-width">
  <h2>{{ section.settings.heading }}</h2>
  <input type="text" id="faq-search" class="faq-search" placeholder="Search FAQs...">

  {% assign all_categories = section.blocks | map: 'settings' | map: 'category' | uniq %}

  {% for category in all_categories %}
    <div class="faq-category">
      <h3>{{ category }}</h3>

      {% for block in section.blocks %}
        {% if block.settings.category == category %}
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>{{ block.settings.question }}</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}

  <p id="no-results-message" style="text-align:center; margin-top:2rem;">
    Couldn't find your answer?
    <a href="/pages/contact" style="color: var(--color-foreground); font-weight: 600;">Contact us here</a>.
  </p>
</div>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling;
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      btn.setAttribute('aria-expanded', !isExpanded);

      if (!isExpanded) {
        answer.style.maxHeight = answer.scrollHeight + 'px';
      } else {
        answer.style.maxHeight = '0';
      }
    });
  });
</script>

<script>
  const searchInput = document.getElementById('faq-search');
  const faqCategories = document.querySelectorAll('.faq-category');
  const noResultsMessage = document.getElementById('no-results-message');

  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    let hasAnyVisible = false;

    faqCategories.forEach(category => {
      const items = category.querySelectorAll('.faq-item');
      let hasVisibleItem = false;

      items.forEach(item => {
        const question = item.querySelector('.faq-question')?.textContent.toLowerCase() || '';
        const answer = item.querySelector('.faq-answer')?.textContent.toLowerCase() || '';

        const isMatch = question.includes(query) || answer.includes(query);

        item.style.display = isMatch ? 'block' : 'none';
        if (isMatch) hasVisibleItem = true;
      });

      category.style.display = hasVisibleItem ? 'block' : 'none';
      if (hasVisibleItem) hasAnyVisible = true;
    });
  });
</script>

