<div class="qab" id="qab-{{ section.id }}">
  <div class="qab__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="qab__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="qab__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.rating != blank -%}<p class="qab__rating"><span class="qab__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating }}</p>{%- endif -%}
    <div class="qab__text">{{ section.settings.text }}</div>
    {%- if section.settings.button_url != blank -%}
      <a class="qab__btn" href="{{ section.settings.button_url }}" target="_blank" rel="noopener">{{ section.settings.button_label }} &rarr;</a>
    {%- endif -%}
  </div>
</div>
{%- style -%}
  #qab-{{ section.id }}{max-width:1500px;margin:{{ section.settings.margin_top }}px auto 0;padding:0 15px}
  #qab-{{ section.id }} .qab__inner{background:#151515;color:#fff;border-radius:6px;padding:44px 24px;text-align:center}
  #qab-{{ section.id }} .qab__eyebrow{margin:0 0 6px;font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase;color:#ff9900}
  #qab-{{ section.id }} .qab__heading{margin:0 0 8px;color:#fff;font-size:clamp(2.4rem,3vw,3.4rem)}
  #qab-{{ section.id }} .qab__rating{margin:0 0 10px;font-size:1.5rem;color:#e6e6e6}
  #qab-{{ section.id }} .qab__stars{color:#ffa41c;letter-spacing:2px}
  #qab-{{ section.id }} .qab__text{max-width:640px;margin:0 auto 22px;color:#cfcfcf;font-size:1.5rem}
  #qab-{{ section.id }} .qab__text p{margin:0}
  #qab-{{ section.id }} .qab__btn{display:inline-block;background:#ff9900;color:#111;font-weight:700;font-size:1.5rem;padding:13px 28px;border-radius:999px;text-decoration:none}
  #qab-{{ section.id }} .qab__btn:hover{background:#ffad33}
  @media screen and (max-width:749px){#qab-{{ section.id }}{padding:0 8px}}
{%- endstyle -%}
{% schema %}
{
  "name": "Amazon store banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Also available on" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop QAWACH on Amazon" },
    { "type": "text", "id": "rating", "label": "Rating line", "default": "4.6 out of 5 – 200+ pillow cover ratings on Amazon" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Prefer to shop on Amazon? Our genuine lambskin jackets, pillow covers, belts and leather sheets are also available in the QAWACH Amazon store.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Visit our Amazon store" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 80, "step": 5, "unit": "px", "label": "Top spacing", "default": 30 }
  ],
  "presets": [ { "name": "Amazon store banner" } ]
}
{% endschema %}
