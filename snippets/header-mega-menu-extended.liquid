{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu-extended' %}
{% endcomment %}

{% style %}
    .curved-borders{
      border-radius: 0px;
    }

    .full-width{
      height: 100%;
      width: 100%;
      object-fit: cover;
      object-position: center center;
    }

    .featured-grid{
      grid-template-areas:
        "link link link link featured featured"
        "link link link link featured featured";
      gap: 1.8rem 1rem;
    }

    .mega-menu__content {
      display: flex;
      flex-direction: row;
      justify-content: center;
    }

    .mega-menu__list {
      width: 60%;
      display: flex;
      flex-direction: row !important;
      margin: 0;
    }
    .header--top-center .mega-menu__list>li {
      padding-right: 0 !important;
      margin: 0 2rem !important;
    }
    .mega-menu__item-link {
      width: fit-content;
    }
    .mega-menu__item-link a {
      transition: all 300ms ease-in;
    }
    .mega-menu__item-link:hover a {
      color: #a52a2a;
      text-decoration: underline;
    }
    .featured-item{
      /* grid-area: featured; */
    }
    .url__img {
      position: relative;
    }

    .url__img:hover .url__text {
      color: #a52a2a;
      background-color: #f5f5f5;
      border-color: #a52a2a;
    }
    .url__text {
      position: absolute;
      bottom: 25px;
      left: 30px;
      z-index: 1000;
    }/* Overlay styles */
  .image-container {
    position: relative;
    display: inline-block;
    width: 400px;
    height: 400px;
  }

  .collection-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3); /* Semi-transparent black overlay */
    border-radius: 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    /* opacity: 0; */
    transition: opacity 0.3s ease;
  }

  .overlay-text {
    color: white;
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    padding: 1rem;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
    max-width: 80%;
    line-height: 1.3;
  }

  /* .url__img:hover .collection-overlay {
    opacity: 1;
  } */

  /* .image-container::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 0px;
    opacity: 1;
    transition: opacity 0.3s ease;
  } */

  /* .url__img:hover .image-container::after {
    opacity: 1; /* Show overlay on hover */
  } */
{% endstyle %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{ 'icon-caret.svg' | inline_asset_content }}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <ul
                  class="mega-menu__list page-width {% if settings.extended-megamenu-featured-img and settings.extended-megamenu-show-featured == "yes" %} featured-grid {% endif %}"
                  role="list"
                  style="{% if link.handle=="brand" %} width: unset;{% endif %}"
                >
                  {%- for childlink in link.links -%}
                    <li class="mega-menu__item-link">
                      {% comment %} Put a Featured Image Here {% endcomment %}
                      {% if settings['extended-megamenu-show-imgs'] == 'yes' %}
                        <a href="{{ childlink.url }}">
                          {% if childlink.object.featured_image %}
                            {{
                              childlink.object.featured_image
                              | image_url: width: 150, height: 150
                              | image_tag: class: 'curved-borders'
                            }}
                          {% elsif childlink.object.image %}
                            {{
                              childlink.object.image
                              | image_url: width: 150, height: 150
                              | image_tag: class: 'curved-borders'
                            }}
                          {% endif %}
                        </a>
                      {% endif %}

                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="list-unstyled" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                {% if settings['extended-megamenu-featured-img']
                  and settings['extended-megamenu-show-featured'] == 'yes'
                %}
                  {% if link.handle != 'brand' %}
                    <div class="featured-item">
                      {% assign image__url = '' %}
                      {% assign url__toOpen = '' %}
                      {% if link.handle == 'men' %}
                        {% assign image__url = 'men-jacket-menu.png' %}
                        {% assign url__toOpen = '/collections/men' %}
                      {% elsif link.handle == 'women' %}
                        {% assign image__url = 'women-jacket-menu.jpg' %}
                        {% assign url__toOpen = '/collections/women' %}
                      {% elsif link.handle == 'celebrity' %}
                        {% assign image__url = 'celebrity-jacket-menu.png' %}
                        {% assign url__toOpen = '/collections/celebrity' %}
                      {% endif %}
                      <a href="{{ url__toOpen }}" class="url__img">
                        <div class="image-container">
                          <img src="{{ image__url | asset_url }}" class="curved-borders" width="400" height="400" alt="{{ link.title | escape }}">
                          <div class="collection-overlay">
                            <span class="overlay-text">
                              {% case link.handle %}
                                {% when 'men' %}
                                  Men’s Leather Styles
                                {% when 'women' %}
                                  Women's Luxury Styles
                                {% when 'celebrity' %}
                                  Celebrity-Inspired Looks
                                {% else %}
                                  Shop {{ link.handle | capitalize }}
                              {% endcase %}
                            </span>
                          </div>
                          <button class="url__text button button-secondary">
                            {% case link.handle %}
                              {% when 'men' %}
                                Browse Men's Collection
                              {% when 'women' %}
                                Discover Women's Styles
                              {% when 'celebrity' %}
                                View Celebrity Picks
                              {% else %}
                                Shop All {{ link.handle | capitalize }}
                            {% endcase %}
                          </button>
                        </div>
                      </a>
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
