<script>
  (function () {
    var SALE_END = Date.parse('2026-11-02T05:00:00Z');
    var now = Date.now();

    // Sale line in the hero shows only while the Halloween discount is live
    document.querySelectorAll('[data-qwa-until]').forEach(function (el) {
      if (now < Date.parse(el.getAttribute('data-qwa-until'))) el.classList.add('is-on');
    });

    // After the sale ends, swap the announcement bar to the Winter Arc message (so it never advertises an expired discount)
    if (now > SALE_END) {
      document.querySelectorAll('.announcement-bar__message span').forEach(function (s) {
        if (/spooky|10%/i.test(s.textContent)) s.textContent = 'The Winter Arc is here: handcrafted leather, built for cold nights';
      });
    }

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // ---------- Light snowfall ----------
    try {
      var cv = document.createElement('canvas');
      cv.id = 'qwa-snow'; cv.setAttribute('aria-hidden', 'true');
      document.body.appendChild(cv);
      var ctx = cv.getContext('2d'), dpr = Math.min(window.devicePixelRatio || 1, 2), W, H, flakes = [];
      function size() { W = window.innerWidth; H = window.innerHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
      size(); window.addEventListener('resize', size);
      var n = W < 750 ? 34 : 70;
      for (var i = 0; i < n; i++) flakes.push({ x: Math.random() * W, y: Math.random() * H, r: 0.8 + Math.random() * 2.2,
        v: 0.35 + Math.random() * 0.9, s: Math.random() * 6.28, a: 0.35 + Math.random() * 0.5 });
      function tick() {
        if (!document.hidden) {
          ctx.clearRect(0, 0, W, H);
          for (var j = 0; j < flakes.length; j++) {
            var f = flakes[j]; f.y += f.v; f.s += 0.01; f.x += Math.sin(f.s) * 0.35;
            if (f.y > H + 5) { f.y = -5; f.x = Math.random() * W; }
            ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, 6.283); ctx.fillStyle = 'rgba(255,255,255,' + f.a + ')'; ctx.fill();
          }
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    } catch (e) {}
  })();
</script>

