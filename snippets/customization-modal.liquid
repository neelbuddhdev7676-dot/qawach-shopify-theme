<script>
  {% assign customization_collections = customization_collection %}
    window.productData = {
      basePrice: {{ price | money_without_currency | default: 0 }},
      compareAtPrice: {{ compare_at_price | money_without_currency | default: 0 }},
      product: {{ current_product }}
    };
  window.customization_options = [
          {% for product in customization_collections.products %}
          {
            title: "{{ product.title | escape }}",
            image: "{{ product.featured_image | img_url: '300x' }}",
            price: {{ product.price | divided_by: 100 }},
            productId: {{ product.id }},
            variants: {{ product.variants | json }},
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
</script>

<style>

  .modal-right-header {
    display: none
  }
  .modal-compare-price {
    text-decoration: line-through;
    color: rgba(var(--color-foreground), 0.75);
    margin-right: 10px;
    font-size: 0.9em;
  }
  .modal-regular-price {
    color: rgb(var(--color-foreground));
    font-weight: bold;
  }
</style>
