<script>
  // Initialize Shopify data
  window.productData = {
    basePrice: {{ selected_product.price | money_without_currency }},
    product: {{ selected_product | json }},
    variantId: {{ selected_product.variants.first.id }}
  };

  window.customization_options = [
    {% for product in customization_collection.products %}
      {
        title: {{ product.title | json }},
        image: {{ product.featured_image | img_url: '300x' | json }},
        price: {{ product.price | divided_by: 100 }},
        productId: {{ product.id }},
        variants: {{ product.variants | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>

<style>
    .size-chart-container {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      width: 100%;
      margin-top: 10px;
      overflow-x: auto;
    }

    .size-chart-table-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .size-chart-table {
      width: 100%;
      min-width: 700px;
      border-collapse: collapse;
      margin-bottom: 10px;
      border: 1px solid #e1e1e1;
      background-color: #fff;
      font-size: 15px;
    }

    .size-chart-table th,
    .size-chart-table td {
      padding: 12px 14px;
      text-align: center;
      border: 1px solid #e1e1e1;
    }

    .size-chart-table th {
      background-color: #f9f9f9;
      font-weight: 600;
      color: #333;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .size-chart-table tr:nth-child(even) {
      background-color: #fdfdfd;
    }

    .size-chart-table tr:hover {
      background-color: #f1f1f1;
    }

    .size-chart-note {
      text-align: center;
      font-size: 14px;
      color: #666;
      margin-top: 8px;
      font-style: italic;
    }
    .size-chart-button {
      text-decoration: underline;
      background-color: unset;
      border: none;
      padding: 0;
      width: fit-content;
      cursor: pointer;
    }
    /* 🔥 Popup Modal Styles */
  .size-modal-overlay {
    position: fixed; /* make it float above everything */
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6); /* dark backdrop */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999; /* stay on top of all content */
    padding: 20px;
    overflow-y: auto;
  }

  .size-modal {
    background: white;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 30px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    position: relative;
    animation: fadeIn 0.3s ease-out;
  }

  .hidden {
    display: none !important;
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 24px;
    background: none;
    border: none;
    cursor: pointer;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }


    /* Responsive */
    @media (max-width: 768px) {
      .size-chart-table th,
      .size-chart-table td {
        padding: 10px 8px;
        font-size: 13px;
      }

      .size-chart-table {
        font-size: 13px;
      }
    }

   
   h2.modal-right-header {
    display: block !important;
  }

  /* Top-Bottom Layout */
  .custom-order-page-container {
    display: flex;
    flex-direction: column; /* Stack top to bottom */
    gap: 20px;
    width: 100%;
  }
  
  .modal-left {
    width: 100%; /* Full width */
    border-right: none;
    border-bottom: 1px solid #e1e1e1;
    padding-right: 0;
    padding-bottom: 15px;
    margin-bottom: 10px;
  }

  .modal-menu {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
    list-style: none;
    border: 1px solid #e1e1e1;
    border-radius: 4px;
    overflow: hidden;
  }

  .modal-menu-item {
    flex: 1; /* Spread items evenly */
    text-align: center;
    cursor: pointer;
    padding: 12px 15px;
    transition: background-color 0.2s;
    white-space: nowrap;
    border-right: 1px solid #e1e1e1; /* Separator */
    background-color: #fff;
  }

  .modal-menu-item:last-child {
    border-right: none;
  }

  .modal-menu-item:hover,
  .modal-menu-item.active {
    background-color: #f0f0f0;
  }

  .modal-right {
    width: 100%; /* Cover the page */
    flex-grow: 1;
  }

  /* Ensure options inside modal-right are also full width/responsive */
  .custom-order-section {
    width: 100%;
  }
</style>
