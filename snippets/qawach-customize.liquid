{%- comment -%}
  "You dream, we customize." Floating button on every page plus the customization request form.
  The form is Shopify's own contact form, so requests arrive in the store's email inbox.
  Any link to #customize, or any element with data-qcz-open, opens it too.
{%- endcomment -%}
{%- liquid
  assign qcz_kind = ''
  assign qcz_item = ''
  if template.name == 'product' and product
    assign qcz_item = product.title | remove: ' | QAWACH' | remove: 'QAWACH ' | remove: 'Qawach '
    assign t = product.title | downcase
    if t contains 'pillow' or t contains 'cushion'
      assign qcz_kind = 'Pillow cover'
    elsif t contains 'jacket'
      assign qcz_kind = 'Leather jacket'
    elsif t contains 'coat'
      assign qcz_kind = 'Leather coat'
    else
      assign qcz_kind = 'Other leather product'
    endif
  elsif template.name == 'collection' and collection
    assign t = collection.title | downcase
    if t contains 'pillow'
      assign qcz_kind = 'Pillow cover'
    elsif t contains 'jacket'
      assign qcz_kind = 'Leather jacket'
    elsif t contains 'coat'
      assign qcz_kind = 'Leather coat'
    endif
  endif
-%}
<style>
  .qcz-fab { position: fixed; left: max(16px, env(safe-area-inset-left, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); z-index: 60;
    display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px 0 8px; border: 0; border-radius: 999px; cursor: pointer;
    background: #1C1814; color: #F5EDE1; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    box-shadow: 0 14px 34px rgba(28,24,20,.28), 0 0 0 1px rgba(212,174,94,.45); transition: transform .35s cubic-bezier(.2,.7,.2,1), background .3s; }
  .qcz-dlg *, .qcz-dlg *::before, .qcz-dlg *::after, .qcz-fab, .qcz-fab * { box-sizing: border-box; }
  .qcz-fab { transition: transform .35s cubic-bezier(.2,.7,.2,1), background .3s, opacity .35s; }
  .qcz-fab.qcz-away { opacity: 0; transform: translateY(18px); pointer-events: none; }
  .qcz-fab:hover { transform: translateY(-3px); background: #2A231C; }
  .qcz-fab:focus-visible { outline: 2px solid #D4AE5E; outline-offset: 3px; }
  .qcz-fab-ic { position: relative; width: 38px; height: 38px; border-radius: 50%; background: #D4AE5E; color: #1C1814; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .qcz-fab-ic svg { width: 19px; height: 19px; }
  .qcz-fab-ic::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid rgba(212,174,94,.7); animation: qcz-pulse 2.6s ease-out infinite; }
  @keyframes qcz-pulse { 0% { transform: scale(.85); opacity: .9; } 100% { transform: scale(1.45); opacity: 0; } }
  .qcz-fab-short { display: none; }
  .qcz-dlg { width: min(560px, calc(100vw - 24px)); max-height: calc(100svh - 24px); padding: 0; border: 0; border-radius: 14px; background: #F7F2EA; color: #1C1814; overflow: auto;
    box-shadow: 0 40px 100px rgba(14,12,10,.45); font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; }
  .qcz-dlg::backdrop { background: rgba(14,12,10,.62); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .qcz-dlg[open] { animation: qcz-in .45s cubic-bezier(.2,.7,.2,1); }
  @keyframes qcz-in { from { opacity: 0; transform: translateY(24px) scale(.98); } to { opacity: 1; transform: none; } }
  .qcz-head { position: relative; padding: 28px 28px 22px; background: #0E0C0A; color: #F5EDE1; }
  .qcz-eyebrow { margin: 0 0 10px; font-size: 11px; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; color: #D4AE5E; }
  .qcz-title { margin: 0; font-family: 'Cormorant Garamond', Garamond, Georgia, serif; font-weight: 500; font-size: clamp(30px, 6vw, 40px); line-height: 1.02; letter-spacing: 0; }
  .qcz-title em { color: #F1D79A; }
  .qcz-lead { margin: 12px 0 0; font-size: 14px; line-height: 1.6; color: #CFC3B1; }
  .qcz-x { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(245,237,225,.1); color: #F5EDE1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .qcz-x:hover { background: rgba(245,237,225,.2); }
  .qcz-body { padding: 22px 28px 28px; display: flex; flex-direction: column; gap: 14px; }
  .qcz-body form { display: flex; flex-direction: column; gap: 14px; margin: 0; }
  .qcz-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .qcz-f { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .qcz-f label, .qcz-legend { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: #6E655B; }
  .qcz-f input, .qcz-f textarea, .qcz-f select { width: 100%; min-height: 46px; padding: 11px 14px; border: 1px solid #DDD3C4; border-radius: 8px; background: #FFFDF9; color: #1C1814; font: inherit; font-size: 15px; letter-spacing: 0; box-shadow: none; }
  .qcz-f textarea { min-height: 112px; resize: vertical; line-height: 1.5; }
  .qcz-f input:focus, .qcz-f textarea:focus, .qcz-f select:focus { outline: 2px solid #8E6B2C; outline-offset: 0; border-color: #8E6B2C; }
  .qcz-kinds { display: flex; flex-wrap: wrap; gap: 8px; border: 0; padding: 0; margin: 0; }
  .qcz-kinds input { position: absolute; opacity: 0; pointer-events: none; }
  .qcz-kinds label { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid #DDD3C4; background: #FFFDF9; font-size: 13px; font-weight: 500; letter-spacing: 0; text-transform: none; color: #1C1814; cursor: pointer; }
  .qcz-kinds input:checked + label { background: #1C1814; border-color: #1C1814; color: #F5EDE1; }
  .qcz-kinds input:focus-visible + label { outline: 2px solid #8E6B2C; outline-offset: 2px; }
  .qcz-item { margin: 0; padding: 10px 14px; border-radius: 8px; background: #EFE6D8; font-size: 13px; color: #4E463E; }
  .qcz-send { min-height: 52px; border: 0; border-radius: 999px; background: #1C1814; color: #F5EDE1; font: inherit; font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; cursor: pointer; }
  .qcz-send:hover { background: #8E6B2C; }
  .qcz-note { margin: 0; font-size: 12px; color: #6E655B; text-align: center; }
  .qcz-ok { padding: 18px; border-radius: 10px; background: #EAF1E6; color: #2F4A26; font-size: 15px; line-height: 1.5; }
  .qcz-err { padding: 12px 14px; border-radius: 8px; background: #F6E3DF; color: #7A2A1E; font-size: 14px; }
  .qcz-err ul { margin: 6px 0 0; padding-left: 18px; }
  @media (max-width: 749px) {
    .qcz-fab { min-height: 48px; padding: 0 16px 0 6px; font-size: 11px; letter-spacing: .12em; gap: 8px; }
    .qcz-fab-ic { width: 36px; height: 36px; }
    .qcz-fab-long { display: none; }
    .qcz-fab-short { display: inline; }
    .qcz-head { padding: 24px 20px 18px; }
    .qcz-body { padding: 18px 20px 22px; }
    .qcz-row { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .qcz-fab-ic::after, .qcz-dlg[open] { animation: none; } }
</style>

<button class="qcz-fab" type="button" data-qcz-open aria-haspopup="dialog" aria-controls="qcz-dlg">
  <span class="qcz-fab-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M8.6 7.6 20 18M8.6 16.4 20 6"/></svg></span>
  <span class="qcz-fab-long">Customize your own</span><span class="qcz-fab-short">Customize</span>
</button>

<dialog class="qcz-dlg" id="qcz-dlg" aria-labelledby="qcz-title">
  <div class="qcz-head">
    <p class="qcz-eyebrow">Qawach custom atelier</p>
    <h2 class="qcz-title" id="qcz-title">You dream, <em>we customize.</em></h2>
    <p class="qcz-lead">Any jacket, coat or pillow cover in the store can be made your way: your size, leather, colour, lining or details. Tell us your idea and we will reply by email.</p>
    <button class="qcz-x" type="button" data-qcz-close aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="qcz-body">
    {%- form 'contact', id: 'qcz-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="qcz-ok" data-qcz-state="ok" role="status">Thank you. Your custom request has reached our workshop, and we will reply by email.</div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="qcz-err" data-qcz-state="err" role="alert">Please check the form.{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <input type="hidden" name="contact[Request]" value="Custom order">
        <input type="hidden" name="contact[Page]" value="{{ request.origin }}{{ request.path }}">
        {%- if qcz_item != '' -%}
          <input type="hidden" name="contact[Product]" value="{{ qcz_item | escape }}">
          <p class="qcz-item">Customizing: <b>{{ qcz_item }}</b></p>
        {%- endif -%}
        <div class="qcz-f">
          <span class="qcz-legend" id="qcz-kind-l">What would you like made?</span>
          <div class="qcz-kinds" role="radiogroup" aria-labelledby="qcz-kind-l">
            {%- assign kinds = 'Leather jacket,Pillow cover,Leather coat,Other leather product' | split: ',' -%}
            {%- for k in kinds -%}
              <input type="radio" id="qcz-k{{ forloop.index }}" name="contact[Item type]" value="{{ k }}" {% if qcz_kind == k or qcz_kind == '' and forloop.first %}checked{% endif %}><label for="qcz-k{{ forloop.index }}">{{ k }}</label>
            {%- endfor -%}
          </div>
        </div>
        <div class="qcz-row">
          <div class="qcz-f"><label for="qcz-name">Name</label><input id="qcz-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
          <div class="qcz-f"><label for="qcz-email">Email</label><input id="qcz-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
        </div>
        <div class="qcz-f"><label for="qcz-phone">Phone (optional)</label><input id="qcz-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
        <div class="qcz-f"><label for="qcz-idea">Your idea</label><textarea id="qcz-idea" name="contact[body]" required placeholder="Size or measurements, leather, colour, lining, hardware, monogram, or a link to a picture you love.">{{ form.body }}</textarea></div>
        <button class="qcz-send" type="submit">Send my request</button>
        <p class="qcz-note">No payment needed. We will get back to you first.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</dialog>

<script>
  (function () {
    var dlg = document.getElementById('qcz-dlg');
    if (!dlg || dlg.dataset.ready) return;
    dlg.dataset.ready = '1';
    function open(e) { if (e) e.preventDefault(); if (typeof dlg.showModal === 'function') { if (!dlg.open) dlg.showModal(); } else { dlg.setAttribute('open', ''); } }
    function close() { if (typeof dlg.close === 'function') dlg.close(); else dlg.removeAttribute('open'); }
    document.addEventListener('click', function (e) {
      var t = e.target.closest ? e.target.closest('[data-qcz-open], a[href$="#customize"]') : null;
      if (t) { open(e); return; }
      if (e.target.closest && e.target.closest('[data-qcz-close]')) { close(); return; }
      if (e.target === dlg) close();
    });
    if (location.hash === '#qcz-form' || location.hash === '#customize' || (dlg.querySelector('[data-qcz-state]') && /contact_posted/.test(location.search))) open();
    function watch() {
      var fab = document.querySelector('.qcz-fab');
      var twin = document.querySelector('.qbf-ctas');
      if (fab && twin && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (es) { fab.classList.toggle('qcz-away', es[0].isIntersecting); }).observe(twin);
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch); else watch();
  })();
</script>
